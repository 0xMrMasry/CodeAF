    {
      "$ref": "#/$defs/FactoriesResponse"
    },
    {
      "$ref": "#/$defs/AttachFactoryRequest"
    },
    {
      "$ref": "#/$defs/HandOffCard"
    },
    {
      "$ref": "#/$defs/SendHandOffRequest"
    },
    {
      "$ref": "#/$defs/HandOffResponse"
    },
    {
      "$ref": "#/$defs/PowerRequest"
    },
    {
      "$ref": "#/$defs/FactoryChangedEvent"
    },
    {
      "$ref": "#/$defs/FactoryEvent"
    }
  ],
  "title": "codeaf app factory contract",
