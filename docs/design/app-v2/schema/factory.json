        },
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "solo",
            "team"
          ]
        },
        "operator": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "unreachable",
            "signed_out"
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "url",
        "name",
        "mode",
        "operator",
        "state"
      ]
    },
    "FactoryChangedEvent": {
      "properties": {
        "factory": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "factory",
        "state"
      ]
    },
    "FactoryEvent": {
      "properties": {
        "factory": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "data": true
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "factory",
        "type",
        "data"
      ]
    },
    "HandOffCard": {
      "properties": {
        "factory": {
          "type": "string"
        },
        "factories": {
          "items": {
            "$ref": "#/$defs/Factory"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "pipeline": {
          "type": "string"
        },
        "issue": {
          "type": "boolean"
        },
        "start": {
          "type": "string",
          "enum": [
            "now",
            "backlog"
          ]
        },
        "assignee": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "factory",
        "factories",
        "id",
        "title",
        "brief",
        "repo",
        "pipeline",
        "issue",
        "start",
        "assignee"
      ]
    },
    "HandOffResponse": {
      "properties": {
        "factory": {
          "type": "string"
        },
        "job": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "factory",
        "job"
      ]
    },
    "PowerRequest": {
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "sleeping",
            "awake"
          ]
        },
        "expect": {
          "$ref": "#/$defs/AgentExpect"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state"
      ]
    },
    "SendHandOffRequest": {
      "properties": {
        "factory": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "pipeline": {
          "type": "string"
        },
        "issue": {
          "type": "boolean"
        },
        "start": {
          "type": "string",
          "enum": [
            "now",
            "backlog"
          ]
        },
        "assignee": {
          "type": "string"
        },
        "expect": {
          "$ref": "#/$defs/AgentExpect"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
