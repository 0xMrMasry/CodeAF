{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AgentExpect": {
      "properties": {
        "state": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "AttachFactoryRequest": {
      "properties": {
        "url": {
          "type": "string"
        },
        "expect": {
          "$ref": "#/$defs/AgentExpect"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url"
      ]
    },
    "FactoriesResponse": {
