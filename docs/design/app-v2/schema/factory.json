    },
    {
      "method": "DELETE",
      "path": "/app/v1/factories/{id}",
      "request": "common.json#/$defs/ExpectRequest",
      "response": "common.json#/$defs/ActionResponse"
    },
    {
      "method": "GET",
      "path": "/app/v1/factories",
