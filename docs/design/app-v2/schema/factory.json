    },
    {
      "method": "POST",
      "path": "/app/v1/agents/{id}/hand-off",
      "request": "common.json#/$defs/ExpectRequest",
      "response": "factory.json#/$defs/HandOffCard"
    },
    {
      "method": "POST",
      "path": "/app/v1/factories/solo",
