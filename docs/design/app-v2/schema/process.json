{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Process": {
      "properties": {
        "id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "done",
            "failed",
            "stopped"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "agent_id",
        "name",
        "command",
        "state",
        "started_at",
        "output_bytes"
      ]
    },
    "ProcessChangedEvent": {
      "properties": {
        "agent": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "agent",
        "process",
        "state"
      ]
    },
    "ProcessOutputEvent": {
      "properties": {
        "process": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "process",
        "text"
      ]
    },
    "ProcessOutputResponse": {
      "properties": {
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "text",
        "truncated"
      ]
    },
    "ProcessesResponse": {
      "items": {
        "$ref": "#/$defs/Process"
      },
      "type": "array"
    }
  },
  "$comment": "Generated by go generate ./internal/appapi. Edit the Go wire types, not this file.",
  "anyOf": [
    {
      "$ref": "#/$defs/Process"
    },
    {
      "$ref": "#/$defs/ProcessesResponse"
    },
    {
      "$ref": "#/$defs/ProcessOutputResponse"
    },
    {
      "$ref": "#/$defs/ProcessChangedEvent"
    },
    {
      "$ref": "#/$defs/ProcessOutputEvent"
    }
  ],
  "title": "codeaf app process contract",
  "x-events": {
    "process.changed": "#/$defs/ProcessChangedEvent",
    "process.output": "#/$defs/ProcessOutputEvent"
  },
  "x-routes": [
    {
      "method": "POST",
      "path": "/app/v1/agents/{id}/processes/stop-all",
      "request": "common.json#/$defs/ExpectRequest",
      "response": "common.json#/$defs/ActionResponse"
    },
    {
      "method": "GET",
      "path": "/app/v1/processes/{pid}/output",
      "response": "process.json#/$defs/ProcessOutputResponse"
    },
    {
      "method": "POST",
      "path": "/app/v1/processes/{pid}/rerun",
      "request": "common.json#/$defs/ExpectRequest",
      "response": "common.json#/$defs/ActionResponse"
    },
    {
      "method": "POST",
      "path": "/app/v1/processes/{pid}/stop",
      "request": "common.json#/$defs/ExpectRequest",
      "response": "common.json#/$defs/ActionResponse"
    },
    {
      "method": "GET",
      "path": "/app/v1/processes",
