        "quick_task",
        "state"
      ]
    },
    "QuickTaskFile": {
      "properties": {
        "path": {
          "type": "string"
        },
        "before_hash": {
          "type": "string"
        },
        "after_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "before_hash",
        "after_hash"
      ]
    },
    "QuickTasksResponse": {
      "items": {
